{
  "name": "Banking System (Java 21 + JavaFX desktop)",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {},
    "ghcr.io/devcontainers/features/maven:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgtk-3-0 libxtst6 libxxf86vm1 libgl1 libasound2",
  "forwardPorts": [6080],
  "portsAttributes": { "6080": { "label": "Desktop (noVNC)", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack"]
    }
  }
}