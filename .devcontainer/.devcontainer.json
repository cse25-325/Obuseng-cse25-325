{
  "name": "Banking System – Java 25",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "ms",
      "installGradle": "false",
      "installMaven": "false"
    },
    "ghcr.io/devcontainers/features/maven:1": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "password",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },

  "containerEnv": {
    "DISPLAY": ":1"
  },

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Banking System GUI",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix",

  "postStartCommand": "rm -f /tmp/.X1-lock && Xvfb :1 -screen 0 1280x800x24 -ac &",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/current"
      }
    }
  }
}